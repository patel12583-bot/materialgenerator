generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  HOD
  FACULTY
  STUDENT
  PARENT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  EXAM_ONLY
  ON_LEAVE
  LATE_PRESENT
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AdmissionStatus {
  APPLIED
  DOCUMENT_VERIFICATION
  APPROVED
  REJECTED
  ENROLLED
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  ALUMNI
  TRANSFERRED
  SUSPENDED
  GRADUATED
}



enum FeeStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
}

enum ExamType {
  MID_SEM
  FINAL_EXAM
  UNIT_TEST
  OTHER
}

model Institution {
  id String @id @default(cuid())
  name String
  campusName String?
  address String?
  phone String?
  website String?
  logoUrl String?
  academicYear String @default("2026-27")
  minimumAttendance Int @default(75)
  attendanceGraceMinutes Int @default(10)
  timezone String @default("Asia/Kolkata")
  departments Department[]
  users User[]
  examSessions ExamSession[]
  admissionApplications AdmissionApplication[]
  feeStructures FeeStructure[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Department {
  id String @id @default(cuid())
  institutionId String
  name String
  code String
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  programs Program[]
  users User[]
  subjects Subject[]
  admissionApplications AdmissionApplication[]
  timetables TimetableEntry[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([institutionId, code])
}

model Program {
  id String @id @default(cuid())
  departmentId String
  name String
  code String
  totalSemesters Int
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  semesters Semester[]
  admissionApplications AdmissionApplication[]
  feeStructures FeeStructure[]
  @@unique([departmentId, code])
}

model Semester {
  id String @id @default(cuid())
  programId String
  number Int
  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  divisions Division[]
  subjects Subject[]
  admissionApplications AdmissionApplication[]
  feeStructures FeeStructure[]
  @@unique([programId, number])
}

model Division {
  id String @id @default(cuid())
  semesterId String
  name String
  semester Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  students Student[]
  timetable TimetableEntry[]
  examSessions ExamSession[]
  admissionApplications AdmissionApplication[]
  @@unique([semesterId, name])
}

model User {
  id String @id @default(cuid())
  institutionId String
  departmentId String?
  username String @unique
  email String?
  phone String?
  passwordHash String?
  googleId String? @unique
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  role Role
  active Boolean @default(true)
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  faculty Faculty?
  student Student?
  parent Parent?
  auditLogs AuditLog[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Faculty {
  id String @id @default(cuid())
  userId String @unique
  employeeCode String @unique
  name String
  phone String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectMappings FacultySubject[]
  timetable TimetableEntry[]
  leavesApproved LeaveRequest[] @relation("LeaveApprover")
  attendanceSessions AttendanceSession[]
  examSessions ExamSession[]
  substituteAssignments SubstituteAssignment[] @relation("SubstituteFaculty")
  mainSubstituteAssignments SubstituteAssignment[] @relation("MainFaculty")
}

model AdmissionApplication {
  id String @id @default(cuid())
  institutionId String
  applicationNo String @unique
  admissionNo String? @unique
  name String
  email String?
  phone String?
  parentName String?
  parentPhone String?
  dateOfBirth DateTime?
  gender String?
  address String?
  departmentId String
  programId String
  semesterId String
  divisionId String
  status AdmissionStatus @default(APPLIED)
  rejectionReason String?
  appliedAt DateTime @default(now())
  verifiedAt DateTime?
  approvedAt DateTime?
  enrolledAt DateTime?
  studentId String? @unique
  institution Institution @relation(fields:[institutionId], references:[id], onDelete:Cascade)
  department Department @relation(fields:[departmentId], references:[id], onDelete:Restrict)
  program Program @relation(fields:[programId], references:[id], onDelete:Restrict)
  semester Semester @relation(fields:[semesterId], references:[id], onDelete:Restrict)
  division Division @relation(fields:[divisionId], references:[id], onDelete:Restrict)
  student Student? @relation("AdmissionStudent", fields:[studentId], references:[id], onDelete:SetNull)
  documents AdmissionDocument[]
  @@index([institutionId,status])
  @@index([divisionId,status])
}

model AdmissionDocument {
  id String @id @default(cuid())
  applicationId String
  type String
  name String
  fileUrl String
  verified Boolean @default(false)
  verificationNote String?
  uploadedAt DateTime @default(now())
  application AdmissionApplication @relation(fields:[applicationId], references:[id], onDelete:Cascade)
  @@index([applicationId,verified])
}

model Student {
  id String @id @default(cuid())
  userId String @unique
  divisionId String
  enrollmentNo String @unique
  rollNo String
  name String
  dateOfBirth DateTime?
  gender String?
  bloodGroup String?
  address String?
  city String?
  state String?
  pinCode String?
  phone String?
  parentPhone String?
  status StudentStatus @default(ACTIVE)
  admissionDate DateTime @default(now())
  documents StudentDocument[]
  division Division @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  admissionApplication AdmissionApplication? @relation("AdmissionStudent")
  fees StudentFee[]
  parentLinks ParentStudent[]
  attendance AttendanceRecord[]
  examAttendance ExamRecord[]
  leaveRequests LeaveRequest[]
  notifications Notification[]
  @@index([divisionId, rollNo])
}

model Parent {
  id String @id @default(cuid())
  userId String @unique
  name String
  phone String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  children ParentStudent[]
}

model ParentStudent {
  parentId String
  studentId String
  parent Parent @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  @@id([parentId, studentId])
}

model Subject {
  id String @id @default(cuid())
  departmentId String
  semesterId String
  code String
  name String
  credits Int @default(0)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  semester Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  facultyMappings FacultySubject[]
  timetable TimetableEntry[]
  attendanceSessions AttendanceSession[]
  examSessions ExamSession[]
  @@unique([semesterId, code])
}

model FacultySubject {
  facultyId String
  subjectId String
  faculty Faculty @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  @@id([facultyId, subjectId])
}

model TimetableEntry {
  id String @id @default(cuid())
  departmentId String
  divisionId String
  subjectId String
  facultyId String
  dayOfWeek Int
  lectureNumber Int
  startTime String
  endTime String
  room String?
  active Boolean @default(true)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  division Division @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  faculty Faculty @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  attendanceSessions AttendanceSession[]
  substituteAssignments SubstituteAssignment[]
  @@unique([divisionId, dayOfWeek, lectureNumber])
  @@index([facultyId, dayOfWeek, lectureNumber])
}

model AttendanceSession {
  id String @id @default(cuid())
  timetableId String
  facultyId String
  subjectId String
  date DateTime
  dateKey String
  startedAt DateTime?
  submittedAt DateTime?
  examType ExamType?
  room String?
  timetable TimetableEntry @relation(fields: [timetableId], references: [id], onDelete: Restrict)
  faculty Faculty @relation(fields: [facultyId], references: [id], onDelete: Restrict)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  records AttendanceRecord[]
  @@unique([timetableId, dateKey])
  @@index([facultyId, dateKey])
}

model AttendanceRecord {
  id String @id @default(cuid())
  sessionId String
  studentId String
  status AttendanceStatus
  markedAt DateTime @default(now())
  correctionReason String?
  session AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  @@unique([sessionId, studentId])
  @@index([studentId, status])
}

model LeaveRequest {
  id String @id @default(cuid())
  studentId String
  approverId String?
  fromDate DateTime
  toDate DateTime
  reason String
  documentUrl String?
  status LeaveStatus @default(PENDING)
  approvedAt DateTime?
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  approver Faculty? @relation("LeaveApprover", fields: [approverId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([studentId, status, fromDate, toDate])
}

model Notification {
  id String @id @default(cuid())
  studentId String?
  channel String
  recipient String
  template String
  dedupeKey String @default(cuid())
  payload Json
  status String @default("QUEUED")
  student Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  providerMessageId String?
  sentAt DateTime?
  createdAt DateTime @default(now())
  @@index([status, createdAt])
  @@index([studentId, createdAt])
}

model AuditLog {
  id String @id @default(cuid())
  actorId String
  action String
  entity String
  entityId String
  reason String?
  before Json?
  after Json?
  createdAt DateTime @default(now())
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  @@index([entity, entityId, createdAt])
}


model SubstituteAssignment {
  id String @id @default(cuid())
  timetableId String
  dateKey String
  mainFacultyId String
  substituteFacultyId String
  reason String?
  active Boolean @default(true)
  timetable TimetableEntry @relation(fields: [timetableId], references: [id], onDelete: Cascade)
  mainFaculty Faculty @relation("MainFaculty", fields: [mainFacultyId], references: [id], onDelete: Restrict)
  substituteFaculty Faculty @relation("SubstituteFaculty", fields: [substituteFacultyId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([timetableId, dateKey])
  @@index([substituteFacultyId, dateKey])
}

model ExamSession {
  id String @id @default(cuid())
  institutionId String
  divisionId String
  subjectId String
  facultyId String
  examType ExamType
  date DateTime
  dateKey String
  room String
  startedAt DateTime?
  submittedAt DateTime?
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  division Division @relation(fields: [divisionId], references: [id], onDelete: Restrict)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  faculty Faculty @relation(fields: [facultyId], references: [id], onDelete: Restrict)
  records ExamRecord[]
  @@unique([divisionId, subjectId, dateKey, examType])
  @@index([facultyId, dateKey])
}

model ExamRecord {
  id String @id @default(cuid())
  sessionId String
  studentId String
  status AttendanceStatus
  markedAt DateTime @default(now())
  session ExamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  @@unique([sessionId, studentId])
  @@index([studentId, status])
}


model StudentDocument {
  id String @id @default(cuid())
  studentId String
  type String
  name String
  fileUrl String?
  verified Boolean @default(false)
  uploadedAt DateTime @default(now())
  student Student @relation(fields:[studentId], references:[id], onDelete:Cascade)
  @@index([studentId, type])
}
model FeeStructure {
  id String @id @default(cuid())
  institutionId String
  programId String
  semesterId String
  name String
  academicYear String
  tuitionFee Int @default(0)
  examFee Int @default(0)
  libraryFee Int @default(0)
  labFee Int @default(0)
  otherFee Int @default(0)
  dueDate DateTime
  active Boolean @default(true)
  institution Institution @relation(fields:[institutionId], references:[id], onDelete:Cascade)
  program Program @relation(fields:[programId], references:[id], onDelete:Restrict)
  semester Semester @relation(fields:[semesterId], references:[id], onDelete:Restrict)
  studentFees StudentFee[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([institutionId, academicYear, active])
  @@index([programId, semesterId])
}

model StudentFee {
  id String @id @default(cuid())
  studentId String
  feeStructureId String
  totalAmount Int
  discountAmount Int @default(0)
  scholarshipAmount Int @default(0)
  paidAmount Int @default(0)
  balanceAmount Int
  dueDate DateTime
  status FeeStatus @default(PENDING)
  student Student @relation(fields:[studentId], references:[id], onDelete:Cascade)
  feeStructure FeeStructure @relation(fields:[feeStructureId], references:[id], onDelete:Restrict)
  payments FeePayment[]
  assignedAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([studentId, feeStructureId])
  @@index([studentId, status])
  @@index([feeStructureId, status])
}

model FeePayment {
  id String @id @default(cuid())
  studentFeeId String
  receiptNo String @unique
  amount Int
  method String
  reference String?
  note String?
  paidAt DateTime @default(now())
  recordedById String
  studentFee StudentFee @relation(fields:[studentFeeId], references:[id], onDelete:Restrict)
  recordedBy User @relation(fields:[recordedById], references:[id], onDelete:Restrict)
  @@index([studentFeeId, paidAt])
}
